# Копировать в .env и заполнить реальными значениями. .env не коммитится (см. .gitignore).

# --- Telegram-бот (AGENTS.md раздел 9-13) ---
TELEGRAM_BOT_TOKEN=
# Через запятую, whitelist экспертов (AGENTS.md раздел 13, безопасность)
ALLOWED_TELEGRAM_USER_IDS=

# --- GLM (LLM-fallback классификации, AGENTS.md раздел 5 и раздел 16 п.9) ---
# Значения скопировать из /Users/user/dev/auto/.env (личный ключ, api.z.ai coding plan)
GLM_PERSONAL_API_KEY=
GLM_PERSONAL_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_PERSONAL_MODEL=glm-5.1

# --- Агент автообновления (AGENTS.md раздел 16 п.8 — контракт ещё не решён) ---
# Заполняется после выбора стратегии интеграции в PLAN.md Фазе 5:
# библиотечный вызов /Users/user/dev/auto/product_agent, либо HTTP-эндпоинт.
AUTOUPDATE_AGENT_MODE=stub
AUTOUPDATE_AGENT_URL=
AUTOUPDATE_AGENT_API_KEY=

# --- Сетевой доступ к RSNET-доменам (docs/STAGE0.md, раздел 2.1) ---
# http://<host>:<port>, используется только для publication.pravo.gov.ru/kremlin.ru/
# government.ru по HTTP (443 у RSNET фильтруется даже через прокси)
RU_PROXY_URL=

# --- БД (db/session.py) ---
DB_PATH=npa_monitor.db
